
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }
    match /products {
      allow list: if true;
    }

    match /teamMembers/{memberId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }
    match /teamMembers {
      allow list: if true;
    }
    
    match /sustainabilityGallery/{imageId} {
      allow get, list: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /sustainabilityGallery {
        allow list: if true;
    }

    match /blogPosts/{docId} {
      allow get, list: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /blogPosts {
      allow list: if true;
    }

    match /keyFigures/main {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /avocadoExportData/{avocadoExportDataId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /qualityCertifications/{qualityCertificationId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }
    match /qualityCertifications {
      allow list: if true;
    }

    match /avocadoVarieties/{avocadoVarietyId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /clientTestimonials/{clientTestimonialId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }
    match /clientTestimonials {
      allow list: if true;
    }

    match /partners/{partnerId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }
    match /partners {
      allow list: if true;
    }

    match /contactInformation/main {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /messages/{messageId} {
      allow get, list, delete: if request.auth != null;
      allow create: if true;
      allow update: if false;
    }
    match /messages {
      allow list: if request.auth != null;
    }
  }
}
