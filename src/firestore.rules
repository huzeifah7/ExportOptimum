
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /sustainabilityGallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /keyFigures/main {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /qualityCertifications/{qualityCertificationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clientTestimonials/{clientTestimonialId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /contactInformation/main {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /messages/{messageId} {
      allow get, list, delete: if request.auth != null;
      allow create: if true;
      allow update: if false;
    }
  }
}
