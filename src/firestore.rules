
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /teamMembers/{memberId} {
      allow get, update, delete: if request.auth != null;
    }

    match /teamMembers {
      allow list, create: if request.auth != null;
    }
    
    match /sustainabilityGallery/{imageId} {
      allow get: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /sustainabilityGallery {
        allow list: if true;
    }

    match /blogPosts/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth.uid == "EjBWKAzrRLeMuEt4ipJYXFEjnot2";
    }

    match /keyFigures/main {
      allow read: if true;
      allow write: if request.auth.uid == "EjBWKAzrRLeMuEt4ipJYXFEjnot2";
    }

    match /avocadoExportData/{avocadoExportDataId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /qualityCertifications/{qualityCertificationId} {
      allow read: if true;
      allow write: if request.auth.uid == "EjBWKAzrRLeMuEt4ipJYXFEjnot2";
    }

    match /avocadoVarieties/{avocadoVarietyId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /clientTestimonials/{clientTestimonialId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /contactInformation/{contactInformationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}

    